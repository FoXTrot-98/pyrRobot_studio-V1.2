WorldInfo { coordinateSystem "ENU" basicTimeStep 32 }
Viewpoint { orientation 0.4 0.2 0.9 2.5 position 9 9 12 }
Background { skyColor [ 0.6 0.7 0.9 ] }
DirectionalLight { direction -1 -1 -3 }
DEF FLOOR Solid {
 translation 0 0 -0.05
 children [ Shape { appearance PBRAppearance { baseColor 0.7 0.7 0.7 roughness 1 } geometry Box { size 20 20 0.1 } } ]
 boundingObject Box { size 20 20 0.1 }
}
DEF TEST_WALL Solid {
 translation 3 0 0.5
 children [ Shape { appearance PBRAppearance { baseColor 0.3 0.5 0.8 } geometry Box { size 0.2 6 1 } } ]
 boundingObject Box { size 0.2 6 1 }
}
DEF OLD_ROBOT Robot { translation -5 0 0 controller "must_not_run" }

DEF WEST Solid { translation -3 0 .5 children [ Shape { geometry Box { size 0.2 8 1 } } ] boundingObject Box { size 0.2 8 1 } }

DEF NORTH Solid { translation 0 4 .5 children [ Shape { geometry Box { size 6 0.2 1 } } ] boundingObject Box { size 6 0.2 1 } }

DEF SOUTH Solid { translation 0 -4 .5 children [ Shape { geometry Box { size 6 0.2 1 } } ] boundingObject Box { size 6 0.2 1 } }

DEF FEATURE Solid { translation -1 2 .5 children [ Shape { geometry Box { size 0.7 0.7 1 } } ] boundingObject Box { size 0.7 0.7 1 } }
