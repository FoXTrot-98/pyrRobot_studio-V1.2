<robot name="pyrobot_four_wheel">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 .25" rpy="0 0 0" />
      <geometry>
        <box size=".72 .48 .22" />
      </geometry>
      <material name="base_link_material">
        <color rgba=".12 .42 .78 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 .25" rpy="0 0 0" />
      <geometry>
        <box size=".72 .48 .22" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 .25" />
      <mass value="8" />
      <inertia ixx=".05" ixy="0" ixz="0" iyy=".05" iyz="0" izz=".05" />
    </inertial>
  </link>
  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".12" length=".10" />
      </geometry>
      <material name="front_left_wheel_material">
        <color rgba=".12 .14 .17 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".12" length=".10" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.5" />
      <inertia ixx=".05" ixy="0" ixz="0" iyy=".05" iyz="0" izz=".05" />
    </inertial>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="front_left_wheel" />
    <origin xyz="0.25 0.31 .12" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="12" velocity="12" />
  </joint>
  <link name="front_left_encoder" />
  <joint name="front_left_encoder_mount" type="fixed">
    <parent link="base_link" />
    <child link="front_left_encoder" />
    <origin xyz="0.25 0.31 .12" rpy="0 0 0" />
  </joint>
  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".12" length=".10" />
      </geometry>
      <material name="rear_left_wheel_material">
        <color rgba=".12 .14 .17 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".12" length=".10" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.5" />
      <inertia ixx=".05" ixy="0" ixz="0" iyy=".05" iyz="0" izz=".05" />
    </inertial>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="rear_left_wheel" />
    <origin xyz="-0.25 0.31 .12" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="12" velocity="12" />
  </joint>
  <link name="rear_left_encoder" />
  <joint name="rear_left_encoder_mount" type="fixed">
    <parent link="base_link" />
    <child link="rear_left_encoder" />
    <origin xyz="-0.25 0.31 .12" rpy="0 0 0" />
  </joint>
  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".12" length=".10" />
      </geometry>
      <material name="front_right_wheel_material">
        <color rgba=".12 .14 .17 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".12" length=".10" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.5" />
      <inertia ixx=".05" ixy="0" ixz="0" iyy=".05" iyz="0" izz=".05" />
    </inertial>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="front_right_wheel" />
    <origin xyz="0.25 -0.31 .12" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="12" velocity="12" />
  </joint>
  <link name="front_right_encoder" />
  <joint name="front_right_encoder_mount" type="fixed">
    <parent link="base_link" />
    <child link="front_right_encoder" />
    <origin xyz="0.25 -0.31 .12" rpy="0 0 0" />
  </joint>
  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".12" length=".10" />
      </geometry>
      <material name="rear_right_wheel_material">
        <color rgba=".12 .14 .17 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".12" length=".10" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.5" />
      <inertia ixx=".05" ixy="0" ixz="0" iyy=".05" iyz="0" izz=".05" />
    </inertial>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="rear_right_wheel" />
    <origin xyz="-0.25 -0.31 .12" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="12" velocity="12" />
  </joint>
  <link name="rear_right_encoder" />
  <joint name="rear_right_encoder_mount" type="fixed">
    <parent link="base_link" />
    <child link="rear_right_encoder" />
    <origin xyz="-0.25 -0.31 .12" rpy="0 0 0" />
  </joint>
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius=".07" length=".06" />
      </geometry>
      <material name="lidar_link_material">
        <color rgba=".15 .8 .64 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius=".07" length=".06" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.2" />
      <inertia ixx=".05" ixy="0" ixz="0" iyy=".05" iyz="0" izz=".05" />
    </inertial>
  </link>
  <joint name="lidar_mount" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz=".05 0 .44" rpy="0 0 0" />
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size=".07 .12 .06" />
      </geometry>
      <material name="camera_link_material">
        <color rgba=".9 .55 .13 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size=".07 .12 .06" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.1" />
      <inertia ixx=".05" ixy="0" ixz="0" iyy=".05" iyz="0" izz=".05" />
    </inertial>
  </link>
  <joint name="camera_mount" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz=".37 0 .34" rpy="0 0 0" />
  </joint>
  <link name="camera_optical_frame" />
  <joint name="camera_optical_mount" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />
  </joint>
</robot>